{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "docs/AI-DEVELOPER-CONTRACT.md",
    "docs/development-standards.md",
    "docs/CODE-MAP.md"
  ],
  "compaction": {
    "auto": true,
    "prune": false
