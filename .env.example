# AiWay environment variables
# Copy to .env.local for local development, or set these in the Vercel project.
# NEVER commit real secret values. Server-only: none of these reach browser code.

# ---------------------------------------------------------------------------
# Model providers (set at least one)
# ---------------------------------------------------------------------------

# OpenCode Zen (default provider)
OPENCODE_API_KEY=
# Optional override for the OpenCode-compatible base URL
OPENCODE_BASE_URL=

# Google Gemini
GEMINI_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# B.ai
BAI_API_KEY=

# New API (OpenAI-compatible gateway)
NEW_API_KEY=

# Hermes Agent
HERMES_API_KEY=
# Optional override for the Hermes base URL
HERMES_BASE_URL=

# ---------------------------------------------------------------------------
# Live web search (Exa)
# ---------------------------------------------------------------------------

# Used by /api/search. Users may also supply a session key from the UI.
EXA_API_KEY=

# ---------------------------------------------------------------------------
# Publishing pipeline (GitHub + Vercel)
# ---------------------------------------------------------------------------

# Shared secret required by /api/publish and /api/publish-check.
PUBLISH_SECRET=

# GitHub token with repo scope, used to create/update the published repository.
GITHUB_TOKEN=

# Vercel token used to create projects and trigger production deployments.
VERCEL_TOKEN=

# Optional Vercel team/org scoping (either key is accepted).
VERCEL_TEAM_ID=
VERCEL_ORG_ID=

# ---------------------------------------------------------------------------
# App access + limits
# ---------------------------------------------------------------------------

# When set, /api routes require this key via the x-aiway-app-key header.
APP_ACCESS_KEY=

# Public URL of the deployment, used for absolute links.
APP_URL=

# Per-IP-per-minute request budget for rate-limited API routes.
AIWAY_RATE_LIMIT_PER_MINUTE=
